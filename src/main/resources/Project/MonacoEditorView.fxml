<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.Controllers.CodeEditorController"
      spacing="14" style="-fx-background-color: #0d1322; -fx-padding: 16;">

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="backBtn" text="← Back" onAction="#handleBackToDashboard"
                style="-fx-background-color: #1e293b; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand; -fx-padding: 6 14; -fx-border-color: #334155; -fx-border-radius: 8px;"/>
        <Label fx:id="projectTitleLabel" text="Practice Challenge" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;"/>
        <Label fx:id="languageBadge" text="JAVA" style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 4 10; -fx-background-radius: 6px; -fx-border-color: #334155; -fx-border-radius: 6px;"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <!-- Action Buttons on Top Right -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="hintBtn" text="💡 Hint" onAction="#handleHint"
                    style="-fx-background-color: #1e293b; -fx-text-fill: #f8fafc; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8. 14; -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8px;"/>
            <Button fx:id="reviewBtn" text="✨ AI Review" onAction="#handleReviewCode"
                    style="-fx-background-color: #8b5cf6; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8 16; -fx-cursor: hand;"/>
            <Button fx:id="runBtn" text="▶ Run Code" onAction="#handleRunCode"
                    style="-fx-background-color: #334155; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8 16; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- 🎯 Mimo-Style Practice Instructions Card -->
    <VBox spacing="6" style="-fx-background-color: #1e293b; -fx-background-radius: 10px; -fx-border-color: #334155; -fx-border-radius: 10px; -fx-padding: 12;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="📖 INSTRUCTIONS:" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="instructionsLabel" text="Loading instructions..." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #e2e8f0;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="🎯 TASK:" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="taskLabel" text="Loading task..." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #e2e8f0; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="✨ EXPECTED OUTPUT:" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="expectedOutputLabel" text="-" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #a78bfa; -fx-font-family: 'Consolas', monospace;"/>
        </HBox>
    </VBox>

    <!-- Main Adjustable Split Pane Layout -->
    <SplitPane fx:id="mainSplitPane" dividerPositions="0.55" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #0d1322; -fx-box-border: transparent; -fx-padding: 0;">

        <!-- Left Side: Code Editor -->
        <VBox spacing="6" style="-fx-background-color: #0d1322; -fx-padding: 0 5 0 0;">
            <Label text="CODE EDITOR" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #0d1322; -fx-background-radius: 8px; -fx-border-color: #1e293b; -fx-border-radius: 8px; -fx-padding: 4;">
                <WebView fx:id="codeWebView" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>

        <!-- Right Side: Terminal Output & AI Review Split Vertically -->
        <SplitPane orientation="VERTICAL" dividerPositions="0.6"
                   style="-fx-background-color: #0d1322; -fx-box-border: transparent; -fx-padding: 0 0 0 5;">

            <!-- Top Right: Terminal Output -->
            <VBox spacing="6" style="-fx-background-color: #0d1322; -fx-padding: 0 0 5 0;">
                <Label text="TERMINAL OUTPUT" style="-fx-text-fill: #38bdf8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <TextArea fx:id="outputConsole" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          style="-fx-control-inner-background: #0d1322; -fx-font-family: 'Consolas', monospace; -fx-font-size: 12px; -fx-text-fill: #e2e8f0; -fx-border-color: #1e293b; -fx-border-radius: 8px;"/>
            </VBox>

            <!-- Bottom Right: AI Code Review -->
            <VBox spacing="6" style="-fx-background-color: #0d1322; -fx-padding: 5 0 0 0;">
                <Label text="✨ AI CODE REVIEW" style="-fx-text-fill: #a78bfa; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <TextArea fx:id="aiReviewArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          promptText="Click 'AI Review' to analyze code quality and optimizations..."
                          style="-fx-control-inner-background: #0d1322; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px; -fx-text-fill: #e2e8f0; -fx-border-color: #1e293b; -fx-border-radius: 8px;"/>
            </VBox>
        </SplitPane>
    </SplitPane>
</VBox>