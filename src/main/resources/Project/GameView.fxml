<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox alignment="TOP_CENTER" spacing="16" prefWidth="900" prefHeight="700"
      style="-fx-background-color: #ffffff; -fx-padding: 24;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.GameController">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button text="✕" onAction="#handleBack"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-border-color: #000000; -fx-border-radius: 50%; -fx-border-width: 1.5; -fx-min-width: 38; -fx-min-height: 38; -fx-cursor: hand;"/>

        <Label fx:id="challengeTitleLabel" text="LIVE CODING ARENA"
               style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20; -fx-border-color: #000000; -fx-border-radius: 20; -fx-border-width: 1.5;"/>

        <HBox HBox.hgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #ffffff; -fx-padding: 6 18; -fx-background-radius: 20; -fx-border-color: #dc2626; -fx-border-radius: 20; -fx-border-width: 1.5;">
            <Label fx:id="timerLabel" text="Time Left: 05:00"
                   style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
    </HBox>

    <!-- Problem Statement Box -->
    <VBox alignment="CENTER_LEFT" spacing="8" prefWidth="850"
          style="-fx-background-color: #ffffff; -fx-padding: 18; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5;">

        <Label fx:id="progressLabel" text="LIVE MATCH IN PROGRESS"
               style="-fx-text-fill: #16a34a; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1.5px;"/>

        <Label fx:id="questionTextLabel" text="Loading Problem Description..." wrapText="true"
               style="-fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold; -fx-line-spacing: 4px;"/>
    </VBox>

    <!-- Workspace: Code Editor & Console Output -->
    <HBox spacing="16" prefWidth="850" VBox.vgrow="ALWAYS">

        <!-- Monaco Code Editor -->
        <VBox spacing="8" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #f8fafc; -fx-padding: 14; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <Label text="💻 CODE EDITOR" style="-fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <WebView fx:id="codeWebView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;" />
        </VBox>

        <!-- Console Output -->
        <VBox spacing="8" prefWidth="340"
              style="-fx-background-color: #f8fafc; -fx-padding: 14; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <Label text="🖥️ CONSOLE OUTPUT / REVIEW" style="-fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <TextArea fx:id="consoleOutputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                      style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 12px; -fx-control-inner-background: #0f172a; -fx-text-fill: #38edf8; -fx-background-radius: 8;"/>
        </VBox>

    </HBox>

    <!-- Footer Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="14" prefWidth="850">
        <Button fx:id="runBtn" text="▶ Run Code" onAction="#handleRunCode" prefHeight="42" prefWidth="150"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #000000; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;"/>

        <Button fx:id="submitBtn" text="🚀 Submit Solution" onAction="#handleSubmitCode" prefHeight="42" prefWidth="180"
                style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

</VBox>