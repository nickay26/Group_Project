<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="22" prefWidth="850" prefHeight="650"
      style="-fx-background-color: #ffffff; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.GameController">

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <!-- Close / Back Button -->
        <Button text="✕" onAction="#handleBack"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-border-color: #000000; -fx-border-radius: 50%; -fx-border-width: 1.5; -fx-min-width: 38; -fx-min-height: 38; -fx-cursor: hand;"/>

        <!-- Challenge Badge (Syntax Error ပြင်ဆင်ထားပါသည်) -->
        <Label fx:id="challengeTitleLabel" text="C++ CODE CHALLENGE"
               style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20; -fx-border-color: #000000; -fx-border-radius: 20; -fx-border-width: 1.5;"/>

        <!-- Spacer -->
        <HBox HBox.hgrow="ALWAYS"/>

        <!-- Timer Badge -->
        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #ffffff; -fx-padding: 6 18; -fx-background-radius: 20; -fx-border-color: #dc2626; -fx-border-radius: 20; -fx-border-width: 1.5;">
            <Label fx:id="timerLabel" text="Time: 15s"
                   style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 15px;"/>
        </HBox>
    </HBox>

    <!-- Top Progress Bar (Controller ဖြင့် Dynamic ထိန်းချုပ်နိုင်ရန် fx:id ထည့်ထားသည်) -->
    <ProgressBar fx:id="progressBar" progress="0.2" prefWidth="800" prefHeight="8"
                 style="-fx-accent: #000000; -fx-control-inner-background: #f1f5f9;"/>

    <!-- Question Box Container -->
    <VBox alignment="CENTER_LEFT" spacing="12" prefWidth="800"
          style="-fx-background-color: #ffffff; -fx-padding: 28; -fx-background-radius: 16; -fx-border-color: #000000; -fx-border-radius: 16; -fx-border-width: 2;">

        <!-- Dynamic Question Counter (fx:id="progressLabel" ထည့်သွင်းထားသည်) -->
        <Label fx:id="progressLabel" text="QUESTION 1 OF 5"
               style="-fx-text-fill: #666666; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1.5px;"/>

        <Label fx:id="questionTextLabel" text="Loading Question..." wrapText="true"
               style="-fx-text-fill: #000000; -fx-font-size: 18px; -fx-font-weight: bold; -fx-line-spacing: 5px;"/>
    </VBox>

    <!-- Answer Options Stack -->
    <VBox alignment="CENTER" spacing="14" prefWidth="800">

        <!-- Option 1 -->
        <Button fx:id="option1Btn" onAction="#handleOption1" text="Option 1"
                maxWidth="Infinity" alignment="BASELINE_LEFT"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 16 22; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-cursor: hand;"/>

        <!-- Option 2 -->
        <Button fx:id="option2Btn" onAction="#handleOption2" text="Option 2"
                maxWidth="Infinity" alignment="BASELINE_LEFT"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 16 22; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-cursor: hand;"/>

        <!-- Option 3 -->
        <Button fx:id="option3Btn" onAction="#handleOption3" text="Option 3"
                maxWidth="Infinity" alignment="BASELINE_LEFT"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 16 22; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-cursor: hand;"/>

        <!-- Option 4 -->
        <Button fx:id="option4Btn" onAction="#handleOption4" text="Option 4"
                maxWidth="Infinity" alignment="BASELINE_LEFT"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 16 22; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-cursor: hand;"/>

    </VBox>

</VBox>