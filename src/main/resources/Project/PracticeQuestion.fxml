<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.PracticeQuestionController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-padding: 15 25; -fx-background-color: #1e293b;">
            <children>
                <Button onAction="#handleBack" text="← Back"
                        style="-fx-background-color: rgba(255,255,255,0.1);
                               -fx-text-fill: white; -fx-background-radius: 6px;
                               -fx-padding: 8 16; -fx-cursor: hand;" />
                <Label fx:id="titleLabel" text="Practice Question"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                <Label fx:id="languageBadge" text="HTML"
                       style="-fx-background-color: #38bdf8; -fx-text-fill: #0f172a;
                              -fx-background-radius: 12px; -fx-padding: 3 12;
                              -fx-font-size: 11px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleHint" text="💡 Hint"
                        style="-fx-background-color: rgba(251,191,36,0.2);
                               -fx-text-fill: #fbbf24; -fx-background-radius: 6px;
                               -fx-padding: 8 16; -fx-cursor: hand;" />
                <Button onAction="#handleSolution" text="👁 Solution"
                        style="-fx-background-color: rgba(139,92,246,0.2);
                               -fx-text-fill: #a78bfa; -fx-background-radius: 6px;
                               -fx-padding: 8 16; -fx-cursor: hand;" />
                <Button fx:id="checkBtn" onAction="#handleCheck" text="✓ Check"
                        style="-fx-background-color: #10b981; -fx-text-fill: white;
                               -fx-background-radius: 6px; -fx-padding: 8 16; -fx-cursor: hand;" />
                <Button fx:id="runBtn" onAction="#handleRun" text="▶ Run"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white;
                               -fx-background-radius: 6px; -fx-padding: 8 16; -fx-cursor: hand;" />
            </children>
        </HBox>
    </top>

    <!-- CENTER — Mimo Style -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #0f172a;">

            <!-- ============================================ -->
            <!-- TASK HEADER                                   -->
            <!-- ============================================ -->
            <VBox style="-fx-padding: 20 30; -fx-background-color: #0f172a;">
                <children>
                    <Label fx:id="taskLabel" text="Add the closing tags in the correct positions."
                           wrapText="true"
                           style="-fx-font-size: 15px; -fx-text-fill: #ffffff;
                                  -fx-font-weight: bold;" />
                </children>
            </VBox>

            <!-- ============================================ -->
            <!-- CODE PREVIEW (Fill-in-blank)                  -->
            <!-- ============================================ -->
            <VBox fx:id="blankSection" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #0f172a; -fx-padding: 0 30;">
                <children>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: #1a2332;
                                       -fx-background: #1a2332;
                                       -fx-border-color: transparent;">
                        <content>
                            <VBox fx:id="blankArea" spacing="8.0"
                                  style="-fx-padding: 25; -fx-background-color: #1a2332;" />
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <!-- ============================================ -->
            <!-- CHOICES (Drag / Click to fill)               -->
            <!-- ============================================ -->
            <VBox fx:id="choiceSection"
                  style="-fx-background-color: #0f172a; -fx-padding: 20 30;">
                <children>
                    <FlowPane fx:id="choiceArea" hgap="12.0" vgap="12.0"
                              alignment="CENTER"
                              style="-fx-padding: 15;
                                     -fx-background-color: rgba(56,189,248,0.05);
                                     -fx-background-radius: 12px;
                                     -fx-border-color: rgba(56,189,248,0.15);
                                     -fx-border-radius: 12px;"
                              prefWrapLength="900.0" />
                </children>
            </VBox>

            <!-- ============================================ -->
            <!-- HIDDEN: Code Editor + Output (write-code)     -->
            <!-- ============================================ -->
            <VBox fx:id="codeSection" visible="false" managed="false"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #0f172a; -fx-padding: 0 30;">
                <children>
                    <TextArea fx:id="codeEditor" VBox.vgrow="ALWAYS"
                              style="-fx-font-family: 'Consolas', monospace;
                                     -fx-font-size: 14px;
                                     -fx-control-inner-background: #0f172a;
                                     -fx-text-fill: #e2e8f0;
                                     -fx-border-color: rgba(56,189,248,0.3);
                                     -fx-border-radius: 8px;
                                     -fx-padding: 10;" />
                </children>
            </VBox>

            <!-- ============================================ -->
            <!-- OUTPUT + AI FEEDBACK (Hidden)                -->
            <!-- ============================================ -->
            <VBox fx:id="outputSection" visible="false" managed="false"
                  style="-fx-padding: 10 30 20 30;">
                <children>
                    <Label text="▶ OUTPUT"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #94a3b8; -fx-padding: 0 0 5 0;" />
                    <TextArea fx:id="outputConsole" editable="false" prefHeight="100.0"
                              style="-fx-font-family: 'Consolas', monospace;
                                     -fx-font-size: 12px;
                                     -fx-control-inner-background: #000000;
                                     -fx-text-fill: #4ade80;
                                     -fx-border-color: rgba(74,222,128,0.3);
                                     -fx-border-radius: 8px; -fx-padding: 10;" />

                    <Label text="🤖 AI FEEDBACK"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #94a3b8; -fx-padding: 10 0 5 0;" />
                    <TextArea fx:id="aiReviewArea" editable="false" prefHeight="80.0"
                              style="-fx-font-family: 'Consolas', monospace;
                                     -fx-font-size: 12px;
                                     -fx-control-inner-background: #1e1b4b;
                                     -fx-text-fill: #c4b5fd;
                                     -fx-border-color: rgba(139,92,246,0.3);
                                     -fx-border-radius: 8px; -fx-padding: 10;" />
                </children>
            </VBox>

        </VBox>
    </center>

</BorderPane>