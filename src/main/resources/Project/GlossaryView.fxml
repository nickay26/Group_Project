<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane style="-fx-background-color: #0F172A;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.Controllers.GlossaryController">

    <stylesheets>
        <URL value="@../Css/help.css" />
    </stylesheets>

    <!-- ✅ TOP -->
    <top>
        <VBox spacing="15.0" style="-fx-background-color: #0F172A; -fx-padding: 10 40 5 40;">
            <Button text="← Back to Help"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #60A5FA;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;
                           -fx-padding: 5 0;" />

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"
                   text="Glossary" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"
                   text="Choose a language to view glossary." />

            <HBox spacing="15.0">
                <children>
                    <Button text="C++" onAction="#showCppGlossary" styleClass="help-sub-btn" />
                    <Button text="Java" onAction="#showJavaGlossary" styleClass="help-sub-btn" />
                    <Button text="Python" onAction="#showPythonGlossary" styleClass="help-sub-btn" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- ✅ CENTER — ၂ ကော်လံ -->
    <center>
        <HBox spacing="0" style="-fx-padding: 0 40 30 40;">

            <!-- ✅ LEFT — Terms List -->
            <VBox prefWidth="220.0" minWidth="220.0" maxWidth="220.0"
                  style="-fx-background-color: #1E293B;
                         -fx-background-radius: 10px 0 0 10px;
                         -fx-padding: 15;">
                <Label text="All Terms &amp; Concepts"
                       style="-fx-text-fill: #94A3B8;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;
                              -fx-padding: 0 0 10 0;" />

                <ListView fx:id="termListView"
                          style="-fx-background-color: transparent;
                                 -fx-control-inner-background: #1E293B;
                                 -fx-background-insets: 0;
                                 -fx-padding: 0;"
                          VBox.vgrow="ALWAYS" />
            </VBox>

            <!-- ✅ RIGHT — Content -->
            <ScrollPane fx:id="contentScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #1E293B;
                               -fx-background: #1E293B;
                               -fx-control-inner-background: #1E293B;
                               -fx-background-radius: 0 10px 10px 0;
                               -fx-padding: 0;">
                <content>
                    <VBox fx:id="contentArea" spacing="15.0"
                          alignment="TOP_LEFT"
                          style="-fx-background-color: #1E293B; -fx-padding: 20;" />
                </content>
            </ScrollPane>

        </HBox>
    </center>

</BorderPane>