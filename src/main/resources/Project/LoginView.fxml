<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.Controllers.LoginController">
    <stylesheets>
        <URL value="@../Css/login.css" />
    </stylesheets>

    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="40.0" top="20.0" />
            </padding>
            <children>
                <Button fx:id="aboutBtn" onAction="#handleAbout" styleClass="nav-button-primary" text="About" />
                <Button fx:id="helpBtn" onAction="#handleHelp" styleClass="nav-button-primary" text="Help" />
                <Button fx:id="registerNavBtn" onAction="#handleRegister" styleClass="nav-button-primary" text="Register" />
            </children>
        </HBox>
    </top>

    <!-- CENTER LOGIN FORM -->
    <center>
        <HBox alignment="CENTER" spacing="0" BorderPane.alignment="CENTER">
            <children>

                <!-- LEFT SIDE: Welcome Text -->
                <VBox alignment="CENTER_LEFT" prefWidth="450.0" spacing="15.0" styleClass="left-panel">
                    <padding>
                        <Insets bottom="40.0" left="60.0" right="20.0" top="40.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold;" styleClass="welcome-label" text="Welcome Back!">
                     <VBox.margin>
                        <Insets bottom="200.0" left="-200.0" top="-500.0" />
                     </VBox.margin></Label>
                        <Label styleClass="main-title" text="Good to see you&#10;Again!" wrapText="true">
                     <VBox.margin>
                        <Insets left="-200.0" top="-200.0" />
                     </VBox.margin></Label>
                    </children>
                </VBox>

                <!-- RIGHT SIDE: Login Form -->
                <VBox alignment="CENTER" prefWidth="500.0" spacing="15.0" styleClass="right-panel">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="60.0" top="40.0" />
                    </padding>
                    <children>

                        <Label styleClass="form-title" text="Login to your account" />
                        <Label style="-fx-font-size: 16;" styleClass="form-subtitle" text="Enter your credentials to continue" />

                        <VBox prefHeight="10.0" />

                        <!-- Email Field with Floating Label -->
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="emailFloatLabel" styleClass="floating-label" text="Email" />
                                <StackPane alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="320.0" styleClass="field-wrapper">
                                    <children>
                                        <TextField fx:id="emailField" promptText="Enter your email address" styleClass="login-field" />
                                        <Label styleClass="field-icon" translateX="14.0" />
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>

                        <!-- Password Field with Floating Label -->
                        <!-- Password Field with Floating Label -->
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="passwordFloatLabel" styleClass="floating-label" text="Password" />

                                <StackPane alignment="CENTER_LEFT" prefHeight="52.0" prefWidth="320.0" styleClass="field-wrapper">
                                    <children>
                                        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="login-field" />

                                        <TextField fx:id="visiblePasswordField" managed="false" promptText="Enter your password" styleClass="login-field" visible="false" />

                                        <Label styleClass="field-icon" translateX="14.0" />

                                        <Button fx:id="togglePasswordBtn" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #94a3b8; -fx-font-size: 16px;" text="👁" StackPane.alignment="CENTER_RIGHT">
                                            <StackPane.margin>
                                                <Insets right="15.0" />
                                            </StackPane.margin>
                                        </Button>
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" prefWidth="320.0" spacing="80.0">
                            <children>
                                <Hyperlink fx:id="forgotLink" onAction="#handleForgotPassword" styleClass="hyperlink" text="Forgot password?">
                           <HBox.margin>
                              <Insets left="300.0" />
                           </HBox.margin></Hyperlink>
                            </children>
                        </HBox>

                        <VBox prefHeight="5.0" />

                        <Button fx:id="loginBtn" onAction="#handleLogin" prefHeight="42.0" prefWidth="320.0" styleClass="btn-primary" text="Continue" />

                        <Label styleClass="or-divider" text="──────  or  ──────" />

                        <Button fx:id="googleBtn" onAction="#handleGoogleLogin" prefHeight="42.0" prefWidth="320.0" styleClass="google-btn" text="🔍  Continue with Google" />

                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>
