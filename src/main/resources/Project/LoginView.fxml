<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- 1. TOP NAVIGATION BAR -->
    <top>
        <HBox alignment="TOP_RIGHT" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="40.0" top="10.0" />
            </padding>
            <children>
                <Button fx:id="aboutBtn" onAction="#handleAbout" text="About" />
                <Button fx:id="helpBtn" onAction="#handleHelp" text="Help" />
                <Button fx:id="registerNavBtn" onAction="#handleRegister" text="Register" />
            </children>
        </HBox>
    </top>

    <!-- 2. CENTER LOGIN CARD -->
    <center>
        <VBox alignment="CENTER" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" fillWidth="false" maxHeight="340.0" maxWidth="420.0" prefHeight="340.0" prefWidth="420.0" spacing="12.0" style="-fx-border-color: #000000; -fx-border-width: 1px; -fx-border-radius: 8px;">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Login" />

                        <TextField fx:id="emailField" prefWidth="300.0" promptText="Email or Username" />
                        <PasswordField fx:id="passwordField" prefWidth="300.0" promptText="Password" />

                        <Button fx:id="signInBtn" onAction="#handleLogin" text="Sign In" />
                        <Button fx:id="googleSignInBtn" onAction="#handleGoogleLogin" text="Sign in with Google" />

                        <Hyperlink fx:id="registerLink" onAction="#handleRegister" text="Don't have an account? Register" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>