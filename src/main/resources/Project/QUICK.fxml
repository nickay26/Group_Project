<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="30" prefWidth="850" prefHeight="650"
      styleClass="match-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.QuickMatchLobbyController">

    <stylesheets>
        <URL value="@../Css/match_lobby.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="QUICK MATCH" styleClass="header-subtitle"/>
        <Label fx:id="statusTitleLabel" text="Finding Opponent..." styleClass="header-title"/>
    </VBox>

    <!-- VS Profile Matchup Container -->
    <HBox alignment="CENTER" spacing="25">

        <!-- User Profile (You) -->
        <VBox alignment="CENTER" spacing="12" prefWidth="280" prefHeight="260" styleClass="player-card, user-card">
            <Label text="👤" styleClass="card-emoji"/>
            <Label fx:id="userNameLabel" text="You" styleClass="card-title"/>
            <Label text="Level 12 • Pro" styleClass="user-rank"/>
        </VBox>

        <!-- VS Icon -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="VS" styleClass="vs-badge"/>
        </VBox>

        <!-- Random Opponent Profile -->
        <VBox alignment="CENTER" spacing="12" prefWidth="280" prefHeight="260" styleClass="player-card">
            <Label fx:id="opponentAvatarLabel" text="🔍" styleClass="card-emoji"/>
            <Label fx:id="opponentNameLabel" text="Searching..." styleClass="card-title"/>
            <Label fx:id="opponentStatusLabel" text="Matching skill level..." styleClass="status-text"/>
        </VBox>

    </HBox>

    <!-- Sub Status / Countdown -->
    <VBox alignment="CENTER" spacing="8">
        <Label fx:id="countdownLabel" text="Searching for online players..." styleClass="status-searching"/>
    </VBox>

    <!-- Cancel Button -->
    <Button text="Cancel Matchmaking" onAction="#handleCancel" styleClass="btn-cancel-danger"/>

</VBox>