<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" styleClass="profile-scroll-pane" stylesheets="@../Css/mainlayout.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.ProfileViewController">
    <content>
        <VBox spacing="25.0" style="-fx-background-color: #0F172A;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <children>

                <!-- PROFILE HEADER CARD -->
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="profile-card">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <StackPane prefWidth="120.0" prefHeight="120.0"
                                   minWidth="120.0" minHeight="120.0"
                                   maxWidth="120.0" maxHeight="120.0">
                            <children>
                                <ImageView fx:id="avatarImageView"
                                           fitHeight="120.0" fitWidth="120.0"
                                           preserveRatio="false"
                                           smooth="true" />
                            </children>
                            <clip>
                                <Circle centerX="60.0" centerY="60.0" radius="60.0" />
                            </clip>
                        </StackPane>

                        <VBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label fx:id="userNameLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="User Name" />
                                <Label fx:id="userEmailLabel" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="user@email.com" />
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- STATISTICS -->
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="Statistics" />

                <HBox spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                    <image><Image url="@../Images/fire.png" /></image>
                                </ImageView>
                                <Label fx:id="streakLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="0" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Day Streak" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="100.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;" text="⚡" />
                                <Label fx:id="xpLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="0" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Total XP" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="100.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                    <image><Image url="@../Images/coin.png" /></image>
                                </ImageView>
                                <Label fx:id="coinLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="0" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Coins" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="100.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                    <image><Image url="@../Images/brain.png" /></image>
                                </ImageView>
                                <Label fx:id="brainLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" text="5" />
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Hearts / Brains" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- COURSES PROGRESS -->
                <VBox spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <children>
                        <Label text="Courses Progress"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;" />

                        <VBox fx:id="coursesProgressContainer" spacing="12.0">
                            <!-- Course items code နဲ့ ထည့်မယ် -->
                        </VBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>