<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" prefWidth="850" prefHeight="650"
      styleClass="main-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.GameModeController">

    <stylesheets>
        <URL value="@../Css/game_mode.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="CODE CHALLENGE" styleClass="header-subtitle"/>
        <Label text="Choose Match Mode to Start" styleClass="header-title"/>
    </VBox>

    <!-- Language Selection Box (First Step) -->
    <VBox alignment="CENTER" spacing="10" maxWidth="420" styleClass="language-box">
        <Label text="Select Programming Language" styleClass="language-label"/>
        <ComboBox fx:id="languageComboBox" prefWidth="340" prefHeight="42" styleClass="custom-combo-box"/>
    </VBox>

    <!-- Action Mode Cards (Direct Click to Play) -->
    <HBox alignment="CENTER" spacing="24" prefWidth="750">

        <!-- Quick Match Card -->
        <VBox fx:id="quickMatchCard" onMouseClicked="#handleQuickMatch"
              alignment="CENTER" spacing="12" prefWidth="320" prefHeight="190"
              styleClass="mode-card, quick-match-card">

            <StackPane styleClass="icon-badge, quick-icon-badge">
                <Label text="⚡" styleClass="card-icon"/>
            </StackPane>

            <Label text="Quick Match ➔" styleClass="card-title"/>
            <Label text="Play against a random player immediately" wrapText="true" alignment="CENTER" styleClass="card-desc"/>
        </VBox>

        <!-- Friend Match Card -->
        <VBox fx:id="friendMatchCard" onMouseClicked="#handleFriendMatch"
              alignment="CENTER" spacing="12" prefWidth="320" prefHeight="190"
              styleClass="mode-card">

            <StackPane styleClass="icon-badge, friend-icon-badge">
                <Label text="👥" styleClass="card-icon"/>
            </StackPane>

            <Label text="Friend Match ➔" styleClass="card-title"/>
            <Label text="Challenge a friend or send an invite code" wrapText="true" alignment="CENTER" styleClass="card-desc"/>
        </VBox>

    </HBox>

</VBox>