<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #0B0F19;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.UserAnalyticsController">

    <!-- Summary Stat Cards -->
    <HBox spacing="16">
        <VBox spacing="6" prefWidth="200" style="-fx-background-color: #1E293B; -fx-padding: 16; -fx-background-radius: 12;">
            <Label text="TOTAL USERS" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="totalUsersLabel" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="6" prefWidth="200" style="-fx-background-color: #1E293B; -fx-padding: 16; -fx-background-radius: 12;">
            <Label text="ACTIVE TODAY" style="-fx-text-fill: #34D399; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="activeTodayLabel" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="6" prefWidth="200" style="-fx-background-color: #1E293B; -fx-padding: 16; -fx-background-radius: 12;">
            <Label text="PREMIUM MEMBERS" style="-fx-text-fill: #F59E0B; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="premiumUsersLabel" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="6" prefWidth="200" style="-fx-background-color: #1E293B; -fx-padding: 16; -fx-background-radius: 12;">
            <Label text="LESSONS COMPLETED" style="-fx-text-fill: #60A5FA; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label fx:id="lessonsCompletedLabel" text="0" style="-fx-text-fill: #F8FAFC; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- User Engagement Table -->
    <VBox VBox.vgrow="ALWAYS" spacing="10">
        <Label text="User Engagement Directory" style="-fx-text-fill: #F8FAFC; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <TableView fx:id="userTableView" VBox.vgrow="ALWAYS" style="-fx-background-color: #1E293B; -fx-background-radius: 12;">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="140"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                <TableColumn fx:id="xpCol" text="XP" prefWidth="80"/>
                <TableColumn fx:id="streakCol" text="Streak" prefWidth="80"/>
                <TableColumn fx:id="coinCol" text="Coins" prefWidth="80"/>
                <TableColumn fx:id="planCol" text="Plan" prefWidth="100"/>
                <TableColumn fx:id="lastLoginCol" text="Last Active" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>