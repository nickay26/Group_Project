<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.LanguageDetailController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
    </padding>

    <top>
        <Button fx:id="backBtn" onAction="#handleBack" style="-fx-cursor: hand; -fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-font-weight: bold; -fx-background-radius: 8px;" text="← Back to Welcome" BorderPane.alignment="TOP_LEFT" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="TOP_LEFT" maxWidth="800.0" spacing="20.0">
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                    <children>
                        <!-- Header Section -->
                        <Label fx:id="titleLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" text="Language Title" />
                        <Label fx:id="subtitleLabel" style="-fx-font-size: 18px; -fx-text-fill: #38bdf8; -fx-font-weight: bold;" text="Language Subtitle" />
                        <Label fx:id="descriptionLabel" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;" wrapText="true" text="Detailed overview..." />

                        <!-- Basic Lessons Section -->
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" text="Basic Level" />
                        <VBox fx:id="basicLessonsContainer" spacing="15.0" />

                        <!-- Intermediate Lessons Section -->
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f8fafc;" text="Intermediate Level" />
                        <VBox fx:id="intermediateLessonsContainer" spacing="15.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>