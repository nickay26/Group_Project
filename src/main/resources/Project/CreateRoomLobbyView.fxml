<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="25" prefWidth="850" prefHeight="650"
      style="-fx-background-color: #ffffff; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.CreateRoomLobbyController">

    <!-- Top Header & Room Code -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button text="← Leave" onAction="#handleLeaveRoom"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #000000; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;"/>

        <Label text="GAME LOBBY" style="-fx-text-fill: #000000; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        <HBox HBox.hgrow="ALWAYS"/>

        <!-- Room Code Display -->
        <HBox alignment="CENTER" spacing="10"
              style="-fx-background-color: #f8fafc; -fx-padding: 8 16; -fx-background-radius: 10; -fx-border-color: #000000; -fx-border-radius: 10; -fx-border-width: 1.5;">
            <Label text="Room Code:" style="-fx-text-fill: #666666; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label fx:id="roomCodeLabel" text="X7K9P2" style="-fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>
            <Button text="📋 Copy" onAction="#handleCopyCode"
                    style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- Main Content Area (Centered Lobby Box) -->
    <HBox alignment="CENTER" prefHeight="500">

        <VBox alignment="CENTER" spacing="20" prefWidth="480"
              style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-background-radius: 16; -fx-border-color: #000000; -fx-border-radius: 16; -fx-border-width: 2;">

            <Label text="PLAYERS MATCHUP" style="-fx-text-fill: #666666; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1.5px;"/>

            <!-- Host (Left Player) Card -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="420"
                  style="-fx-background-color: #f8fafc; -fx-padding: 14 20; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1;">
                <StackPane prefWidth="50" prefHeight="50">
                    <Label fx:id="hostAvatarLabel" text="👤" style="-fx-font-size: 26px;"/>
                    <ImageView fx:id="hostAvatarImageView" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="hostNameLabel" text="You (Host)" style="-fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <Label fx:id="hostStatusLabel" text="Ready" style="-fx-text-fill: #16a34a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Label text="VS" style="-fx-text-fill: #000000; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Opponent (Right Player) Card -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="420"
                  style="-fx-background-color: #ffffff; -fx-padding: 14 20; -fx-background-radius: 12; -fx-border-color: #cccccc; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-border-style: dashed;">
                <StackPane prefWidth="50" prefHeight="50">
                    <Label fx:id="opponentAvatarLabel" text="❓" style="-fx-font-size: 26px;"/>
                    <ImageView fx:id="opponentAvatarImageView" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="opponentNameLabel" text="Waiting for Opponent..." style="-fx-text-fill: #666666; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="opponentStatusLabel" text="Share room code with your opponent" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- Action Button (Start Match) -->
            <Button fx:id="startMatchBtn" text="Start Match ➔" onAction="#handleStartMatch" prefWidth="420" prefHeight="46" disable="true"
                    style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </VBox>

    </HBox>

</VBox>