<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" prefWidth="850" prefHeight="650"
      style="-fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.GameClasses.CreateRoomLobbyController">

    <stylesheets>
        <URL value="@../Css/createroomlobby.css" />
    </stylesheets>

    <!-- Top Header & Room Code -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button text="← Leave" onAction="#handleLeaveRoom" styleClass="btn-outline"/>

        <Label text="GAME LOBBY" styleClass="lobby-header"/>

        <HBox HBox.hgrow="ALWAYS"/>

        <!-- Room Code Display -->
        <HBox alignment="CENTER" spacing="10" styleClass="room-code-box">
            <Label text="Room Code:" styleClass="room-code-title"/>
            <Label fx:id="roomCodeLabel" text="X7K9P2" styleClass="room-code-value"/>
            <Button text="📋 Copy" onAction="#handleCopyCode" styleClass="btn-primary-small"/>
        </HBox>
    </HBox>

    <!-- Main Content Area -->
    <HBox alignment="CENTER" spacing="25" prefHeight="440">

        <!-- Left Side: Players Matchup Slot -->
        <VBox alignment="CENTER" spacing="20" prefWidth="440" styleClass="lobby-card">

            <Label text="PLAYERS" styleClass="section-title"/>

            <!-- Host (Left Player) Card -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="380" styleClass="player-card">
                <StackPane prefWidth="50" prefHeight="50">
                    <Label fx:id="hostAvatarLabel" text="👤" style="-fx-font-size: 26px;"/>
                    <ImageView fx:id="hostAvatarImageView" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="hostNameLabel" text="You (Host)" styleClass="player-name"/>
                    <Label fx:id="hostStatusLabel" text="Ready" styleClass="player-status-ready"/>
                </VBox>
            </HBox>

            <Label text="VS" styleClass="vs-label"/>

            <!-- Opponent (Right Player) Card -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="380" styleClass="player-card-dashed">
                <StackPane prefWidth="50" prefHeight="50">
                    <Label fx:id="opponentAvatarLabel" text="❓" style="-fx-font-size: 26px;"/>
                    <ImageView fx:id="opponentAvatarImageView" fitWidth="50" fitHeight="50" preserveRatio="true"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="opponentNameLabel" text="Waiting for Opponent..." styleClass="player-name-muted"/>
                    <Label fx:id="opponentStatusLabel" text="Send an invite or share code" styleClass="player-status-muted"/>
                </VBox>
            </HBox>

            <!-- Action Button -->
            <Button fx:id="startMatchBtn" text="Start Match ➔" onAction="#handleStartMatch" prefWidth="380" prefHeight="44" disable="true" styleClass="btn-main-action"/>
        </VBox>

        <!-- Right Side: Following Friends List to Invite -->
        <VBox alignment="TOP_CENTER" spacing="12" prefWidth="320" styleClass="lobby-card">

            <Label text="INVITE FOLLOWING" styleClass="lobby-header" style="-fx-font-size: 14px;"/>

            <VBox fx:id="friendsContainer" spacing="10" prefWidth="280">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="friend-row">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <Label text="Alex_Dev" styleClass="player-name" style="-fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                    <Button text="Invite" onAction="#handleInviteFriend" styleClass="btn-primary-small"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="friend-row">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <Label text="Sarah_Coder" styleClass="player-name" style="-fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                    <Button text="Invite" onAction="#handleInviteFriend" styleClass="btn-primary-small"/>
                </HBox>
            </VBox>
        </VBox>

    </HBox>

</VBox>