<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" prefWidth="850" prefHeight="650"
      style="-fx-background-color: #ffffff; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.CreateRoomLobbyController">

    <!-- Top Header & Room Code -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button text="← Leave" onAction="#handleLeaveRoom"
                style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #000000; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;"/>

        <Label text="GAME LOBBY" style="-fx-text-fill: #000000; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        <HBox HBox.hgrow="ALWAYS"/>

        <!-- Room Code Display -->
        <HBox alignment="CENTER" spacing="10"
              style="-fx-background-color: #f8fafc; -fx-padding: 8 16; -fx-background-radius: 10; -fx-border-color: #000000; -fx-border-radius: 10; -fx-border-width: 1.5;">
            <Label text="Room Code:" style="-fx-text-fill: #666666; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label fx:id="roomCodeLabel" text="X7K9P2" style="-fx-text-fill: #000000; -fx-font-size: 16px; -fx-font-weight: bold; -fx-letter-spacing: 2px;"/>
            <Button text="📋 Copy" onAction="#handleCopyCode"
                    style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- Main Content Area -->
    <HBox alignment="CENTER" spacing="25" prefHeight="440">

        <!-- Left Side: Players Matchup Slot -->
        <VBox alignment="CENTER" spacing="20" prefWidth="440"
              style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 16; -fx-border-color: #000000; -fx-border-radius: 16; -fx-border-width: 2;">

            <Label text="PLAYERS" style="-fx-text-fill: #666666; -fx-font-size: 12px; -fx-font-weight: bold; -fx-letter-spacing: 1.5px;"/>

            <!-- Host (You) Profile Card -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="380"
                  style="-fx-background-color: #f8fafc; -fx-padding: 12 18; -fx-background-radius: 12; -fx-border-color: #000000; -fx-border-radius: 12; -fx-border-width: 1;">
                <Label text="👤" style="-fx-font-size: 26px;"/>
                <VBox>
                    <Label fx:id="hostNameLabel" text="You (Host)" style="-fx-text-fill: #000000; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <Label text="Level 12 • Ready" style="-fx-text-fill: #16a34a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <Label text="VS" style="-fx-text-fill: #000000; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <!-- Opponent Slot -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="380"
                  style="-fx-background-color: #ffffff; -fx-padding: 12 18; -fx-background-radius: 12; -fx-border-color: #cccccc; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-border-style: dashed;">
                <Label text="❓" style="-fx-font-size: 26px;"/>
                <VBox>
                    <Label fx:id="opponentNameLabel" text="Waiting for Opponent..." style="-fx-text-fill: #666666; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Send an invite or share code" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- Start Match Button -->
            <Button fx:id="startMatchBtn" text="Start Match ➔" onAction="#handleStartMatch" prefWidth="380" prefHeight="44" disable="true"
                    style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
        </VBox>

        <!-- Right Side: Following Friends List to Invite -->
        <VBox alignment="TOP_CENTER" spacing="12" prefWidth="320"
              style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 16; -fx-border-color: #000000; -fx-border-radius: 16; -fx-border-width: 2;">

            <Label text="INVITE FOLLOWING" style="-fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold;"/>

            <!-- Friends List Container -->
            <VBox fx:id="friendsContainer" spacing="10" prefWidth="280">

                <!-- Friend Item 1 -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <Label text="Alex_Dev" style="-fx-text-fill: #000000; -fx-font-size: 13px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="Invite" onAction="#handleInviteFriend" style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <!-- Friend Item 2 -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <Label text="Sarah_Coder" style="-fx-text-fill: #000000; -fx-font-size: 13px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="Invite" onAction="#handleInviteFriend" style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <!-- Friend Item 3 -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label text="👤" style="-fx-font-size: 18px;"/>
                    <Label text="John_Doe" style="-fx-text-fill: #000000; -fx-font-size: 13px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="Invite" onAction="#handleInviteFriend" style="-fx-background-color: #000000; -fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

            </VBox>
        </VBox>

    </HBox>

</VBox>