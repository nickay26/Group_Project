<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<ScrollPane fx:id="mainScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.Controllers.LeaderboardController">
    <content>
        <!-- StackPane ကို အသုံးပြု၍ နောက်ခံပုံနှင့် အဓိကမာတိကာကို ထပ်疊ပေးခြင်း -->
        <StackPane style="-fx-background-color: #0E1424;">
            <children>
                <!-- Background Image (နောက်ခံပုံ) -->
                <ImageView fitHeight="800.0" fitWidth="1200.0" pickOnBounds="false" preserveRatio="false" StackPane.alignment="CENTER">
                    <image>
                        <!-- သင်ထည့်လိုသော ပုံလမ်းကြောင်းကို ဤနေရာတွင် ပြောင်းပေးပါ (ဥပမာ - @../Images/background.png) -->
                        <Image url="@../Images/background.png" />
                    </image>
                </ImageView>

                <!-- Main Background Layer (မူလ HBox content များ) -->
                <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(14, 20, 36, 0.75);"> <!-- နောက်ခံပုံပေါ်တွင် စာသားများ ပိုပေါ်စေရန် အရောင်အမည်းအမှိုင်း အနည်းငယ်ခံထားပါသည် (လိုလျှင် ဖယ်နိုင်သည်) -->
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>
                        <!-- Left Main Card Container -->
                        <VBox fx:id="leftCardContainer" alignment="TOP_CENTER" prefHeight="600.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: #1A233A; -fx-background-radius: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 12, 0, 0, 4);">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>
                                <!-- 1. EMPTY / PLACEHOLDER STATE VIEW -->
                                <VBox fx:id="placeholderContainer" alignment="CENTER" prefHeight="500.0" spacing="25.0">
                                    <children>
                                        <Label text="🏆">
                                            <font>
                                                <Font size="70.0" />
                                            </font>
                                        </Label>

                                        <Label text="Complete a lesson or earn XP to&#10;join this week's Leaderboard!" textAlignment="CENTER" textFill="#FFFFFF" wrapText="true">
                                            <font>
                                                <Font name="System Bold" size="20.0" />
                                            </font>
                                        </Label>

                                        <Button onAction="#handleStartLearning" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-background-radius: 8px; -fx-cursor: hand;" text="START LEARNING">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                            <padding>
                                                <Insets bottom="12.0" left="32.0" right="32.0" top="12.0" />
                                            </padding>
                                        </Button>
                                    </children>
                                </VBox>

                                <!-- 2. LEADERBOARD RANKING LIST VIEW (Dynamic Population) -->
                                <VBox fx:id="leaderboardListContainer" managed="false" spacing="12.0" visible="false">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="🏆 Weekly Leaderboard" textFill="#FFFFFF">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" />
                                            </padding>
                                        </HBox>

                                        <!-- Player List Rows are added dynamically via Java -->
                                        <VBox fx:id="rankingItemsVBox" spacing="10.0" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Right Side Cards Container -->
                        <VBox prefWidth="340.0" spacing="24.0">
                            <children>
                                <!-- Top Card: League Status -->
                                <VBox spacing="20.0" style="-fx-background-color: #1A233A; -fx-background-radius: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 12, 0, 0, 4);">
                                    <padding>
                                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                                    </padding>
                                    <children>
                                        <Label fx:id="leagueTitleLabel" text=" " textFill="#FFFFFF">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>

                                        <!-- Badges Row -->
                                        <HBox alignment="CENTER" spacing="20.0">
                                            <children>
                                                <!-- 1. Nebula -->
                                                <VBox fx:id="nebulaContainer" alignment="CENTER" spacing="8.0">
                                                    <children>
                                                        <ImageView fx:id="nebulaImg" fitHeight="80.0" fitWidth="81.0"
                                                                   pickOnBounds="true" preserveRatio="true">
                                                            <image>
                                                                <Image url="@../Images/Nebula.png" />
                                                            </image>
                                                            <effect>
                                                                <DropShadow radius="15.0" spread="0.2">
                                                                    <color>
                                                                        <Color red="0.6" green="0.4" blue="1.0" opacity="0.6" />
                                                                    </color>
                                                                </DropShadow>
                                                            </effect>
                                                        </ImageView>
                                                    </children>
                                                </VBox>

                                                <!-- 2. Protostar -->
                                                <VBox fx:id="protostarContainer" alignment="CENTER" spacing="8.0">
                                                    <children>
                                                        <ImageView fx:id="protostarImg" fitHeight="81.0" fitWidth="81.0"
                                                                   pickOnBounds="true" preserveRatio="true">
                                                            <image>
                                                                <Image url="@../Images/Protostar.png" />
                                                            </image>
                                                            <effect>
                                                                <DropShadow radius="15.0" spread="0.2">
                                                                    <color>
                                                                        <Color red="0.3" green="0.6" blue="1.0" opacity="0.6" />
                                                                    </color>
                                                                </DropShadow>
                                                            </effect>
                                                        </ImageView>
                                                    </children>
                                                </VBox>

                                                <!-- 3. Supernova -->
                                                <VBox fx:id="supernovaContainer" alignment="CENTER" spacing="8.0">
                                                    <children>
                                                        <ImageView fx:id="supernovaImg" fitHeight="80.0" fitWidth="80.0"
                                                                   pickOnBounds="true" preserveRatio="true">
                                                            <image>
                                                                <Image url="@../Images/Supernova.png" />
                                                            </image>
                                                            <effect>
                                                                <DropShadow radius="15.0" spread="0.2">
                                                                    <color>
                                                                        <Color red="1.0" green="0.8" blue="0.3" opacity="0.6" />
                                                                    </color>
                                                                </DropShadow>
                                                            </effect>
                                                        </ImageView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </content>
</ScrollPane>