<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane style="-fx-background-color: #0F172A;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.TutorialsController">

    <stylesheets>
        <URL value="@../Css/help.css" />
    </stylesheets>

    <!-- ✅ TOP -->
    <top>
        <VBox spacing="15.0" style="-fx-background-color: #0F172A; -fx-padding: 10 40 5 40;">

            <Button text="← Back to Help"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #60A5FA;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;
                           -fx-padding: 5 0;" />

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"
                   text="Tutorials" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;"
                   text="Choose a language to view tutorials." />

            <HBox spacing="15.0">
                <children>
                    <Button text="C++"
                            onAction="#showCppTutorial"
                            styleClass="help-sub-btn" />

                    <Button text="Java"
                            onAction="#showJavaTutorial"
                            styleClass="help-sub-btn" />

                    <Button text="Python"
                            onAction="#showPythonTutorial"
                            styleClass="help-sub-btn" />
                </children>
            </HBox>

        </VBox>
    </top>

    <!-- ✅ CENTER — Content ScrollPane -->
    <center>
        <ScrollPane fx:id="contentScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-control-inner-background: #0F172A; -fx-padding: 0;">
            <content>
                <!-- ✅ VBox — alignment TOP_LEFT + padding -->
                <VBox fx:id="contentArea" spacing="15.0"
                      alignment="TOP_LEFT"
                      style="-fx-background-color: #0F172A; -fx-padding: 5 40 30 40;" />
            </content>
        </ScrollPane>
    </center>

</BorderPane>