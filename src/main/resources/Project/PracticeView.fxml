<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="750.0" prefWidth="1300.0"
        styleClass="practice-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.Controllers.PracticeController">
    <stylesheets>
        <URL value="@../Css/practice.css" />
    </stylesheets>

    <fx:define>
        <ToggleGroup fx:id="modeGroup" />
    </fx:define>

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-bar">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <children>
                <HBox spacing="0" styleClass="toggle-group">
                    <children>
                        <ToggleButton fx:id="practiceToggle" text="Practice"
                                      styleClass="toggle-btn" selected="true" toggleGroup="$modeGroup" />
                        <ToggleButton fx:id="reviewToggle" text="Review"
                                      styleClass="toggle-btn" toggleGroup="$modeGroup" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="categoryCombo" prefWidth="140.0" styleClass="category-combo" />
            </children>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="scroll-pane">
            <content>
                <GridPane fx:id="cardContainer" hgap="15.0" vgap="60.0"
                          alignment="TOP_LEFT"
                          styleClass="card-container">
                    <padding>
                        <Insets bottom="30.0" left="100.0" right="30.0" top="20.0" />
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                    </columnConstraints>
                </GridPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>