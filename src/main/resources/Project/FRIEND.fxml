<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="30" prefWidth="850" prefHeight="650"
      styleClass="match-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Project.GameClasses.FriendMatchController">

    <stylesheets>
        <URL value="@../Css/match_lobby.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="FRIEND MATCH" styleClass="header-subtitle"/>
        <Label text="Play with a Friend" styleClass="header-title"/>
    </VBox>

    <HBox alignment="CENTER" spacing="30" prefWidth="750">

        <!-- Host Game Card -->
        <VBox alignment="CENTER" spacing="18" prefWidth="340" prefHeight="240" styleClass="liquid-card">
            <Label text="🏠" styleClass="card-emoji"/>
            <Label text="Host a Game" styleClass="card-title"/>
            <Label text="Create a new room and invite your friends to play." wrapText="true" alignment="CENTER" styleClass="card-desc"/>

            <Button text="Create Room ➔" onAction="#handleCreateRoom" prefWidth="220" prefHeight="42" styleClass="btn-primary-action"/>
        </VBox>

        <!-- Join Game Card -->
        <VBox alignment="CENTER" spacing="15" prefWidth="340" prefHeight="240" styleClass="liquid-card">
            <Label text="🔑" styleClass="card-emoji"/>
            <Label text="Join a Game" styleClass="card-title"/>

            <TextField fx:id="joinCodeInput" promptText="Enter Room Code (e.g. X7K9P2)" alignment="CENTER" prefHeight="40" maxWidth="220" styleClass="liquid-text-field"/>

            <Button text="Join Match ➔" onAction="#handleJoinMatch" prefWidth="220" prefHeight="42" styleClass="btn-secondary-action"/>
        </VBox>

    </HBox>

    <Button text="← Back to Game Modes" onAction="#handleBack" styleClass="btn-back"/>

</VBox>