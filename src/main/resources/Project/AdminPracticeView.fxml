<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1100.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.AdminPracticeController">

    <center>
        <HBox spacing="15.0" style="-fx-padding: 20;">

            <!-- LEFT: FORM -->
            <VBox prefWidth="360.0" minWidth="360.0" spacing="8.0"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12px;
                         -fx-border-color: rgba(56,189,248,0.15);
                         -fx-border-radius: 12px;
                         -fx-padding: 15;">
                <children>

                    <Label text="Add / Edit Question"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                  -fx-text-fill: #ffffff;
                                  -fx-padding: 0 0 5 0;" />

                    <!-- Language + Type -->
                    <HBox spacing="8.0">
                        <children>
                            <ComboBox fx:id="languageCombo" maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #0f172a;
                                             -fx-text-fill: white;
                                             -fx-background-radius: 6px;
                                             -fx-pref-height: 30px;
                                             -fx-font-size: 12px;" />
                            <ComboBox fx:id="typeCombo" maxWidth="Infinity"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #0f172a;
                                             -fx-text-fill: white;
                                             -fx-background-radius: 6px;
                                             -fx-pref-height: 30px;
                                             -fx-font-size: 12px;" />
                        </children>
                    </HBox>

                    <TextField fx:id="titleField" promptText="Title"
                               style="-fx-background-color: #0f172a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #64748b;
                                      -fx-background-radius: 6px;
                                      -fx-pref-height: 30px;
                                      -fx-font-size: 12px;
                                      -fx-padding: 6 10;" />

                    <TextArea fx:id="instructionsArea" prefHeight="45.0"
                              promptText="Instructions"
                              style="-fx-control-inner-background: #0f172a;
                                     -fx-text-fill: white;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-background-radius: 6px;
                                     -fx-font-size: 12px;" />

                    <TextArea fx:id="taskArea" prefHeight="45.0"
                              promptText="Task"
                              style="-fx-control-inner-background: #0f172a;
                                     -fx-text-fill: white;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-background-radius: 6px;
                                     -fx-font-size: 12px;" />

                    <TextArea fx:id="starterCodeArea" prefHeight="65.0"
                              promptText="Starter Code"
                              style="-fx-font-family: 'Consolas', monospace;
                                     -fx-font-size: 11px;
                                     -fx-control-inner-background: #0f172a;
                                     -fx-text-fill: #e2e8f0;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-background-radius: 6px;" />

                    <TextArea fx:id="expectedOutputArea" prefHeight="45.0"
                              promptText="Expected Output"
                              style="-fx-font-family: 'Consolas', monospace;
                                     -fx-font-size: 11px;
                                     -fx-control-inner-background: #000000;
                                     -fx-text-fill: #4ade80;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-background-radius: 6px;" />

                    <TextArea fx:id="hintArea" prefHeight="40.0"
                              promptText="Hint"
                              style="-fx-control-inner-background: #0f172a;
                                     -fx-text-fill: white;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-background-radius: 6px;
                                     -fx-font-size: 12px;" />

                    <TextArea fx:id="solutionArea" prefHeight="65.0"
                              promptText="Solution Code"
                              style="-fx-font-family: 'Consolas', monospace;
                                     -fx-font-size: 11px;
                                     -fx-control-inner-background: #0f172a;
                                     -fx-text-fill: #e2e8f0;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-background-radius: 6px;" />

                    <TextField fx:id="blanksField" visible="false" managed="false" />
                    <TextField fx:id="choicesField" visible="false" managed="false" />

                    <Label fx:id="statusLabel"
                           style="-fx-text-fill: #4ade80;
                                  -fx-font-weight: bold;
                                  -fx-font-size: 11px;" />

                    <HBox spacing="8.0">
                        <children>
                            <Button onAction="#handleSave" text="Save Question"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #3b82f6;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 6px;
                                           -fx-padding: 8;
                                           -fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;" />
                            <Button onAction="#handleClear" text="Delete"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #dc2626;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 6px;
                                           -fx-padding: 8;
                                           -fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;" />
                        </children>
                    </HBox>

                </children>
            </VBox>

            <!-- RIGHT: TABLE -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12px;
                         -fx-border-color: rgba(56,189,248,0.15);
                         -fx-border-radius: 12px;
                         -fx-padding: 15;">
                <children>

                    <Label text="Existing Questions List"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                  -fx-text-fill: #ffffff;" />

                    <TableView fx:id="questionTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #0f172a;
                                      -fx-background-radius: 8px;
                                      -fx-border-color: transparent;
                                      -fx-font-size: 11px;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
                            <TableColumn fx:id="colLanguage" text="Language" prefWidth="90.0" />
                            <TableColumn fx:id="colTitle" text="Title" prefWidth="180.0" />
                            <TableColumn fx:id="colType" text="Type" prefWidth="100.0" />
                            <TableColumn fx:id="colTask" text="Task" prefWidth="250.0" />
                        </columns>
                    </TableView>

                </children>
            </VBox>

        </HBox>
    </center>

</BorderPane>