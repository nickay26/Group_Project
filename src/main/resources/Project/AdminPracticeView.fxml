<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="750.0" prefWidth="1100.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.AdminPracticeController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-padding: 15 25; -fx-background-color: #1e293b;">
            <children>
                <Label text="⚙️ Admin — Practice Questions"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRefresh" text="🔄 Refresh"
                        style="-fx-background-color: rgba(56,189,248,0.2);
                               -fx-text-fill: #38bdf8; -fx-background-radius: 6px;
                               -fx-padding: 8 16; -fx-cursor: hand;" />
                <Button onAction="#handleBack" text="← Back"
                        style="-fx-background-color: rgba(255,255,255,0.1);
                               -fx-text-fill: white; -fx-background-radius: 6px;
                               -fx-padding: 8 16; -fx-cursor: hand;" />
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="15.0" style="-fx-padding: 20;">

            <!-- LEFT: FORM -->
            <ScrollPane fitToWidth="true" prefWidth="450.0"
                        style="-fx-background-color: #1e293b;
                               -fx-background-radius: 12px;
                               -fx-border-color: rgba(56,189,248,0.2);
                               -fx-border-radius: 12px;">
                <content>
                    <VBox spacing="10.0" style="-fx-padding: 20;">
                        <children>
                            <Label text="➕ Add / Edit Question"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold;
                                          -fx-text-fill: #38bdf8; -fx-padding: 0 0 10 0;" />

                            <!-- Language + Type -->
                            <HBox spacing="10.0">
                                <children>
                                    <ComboBox fx:id="languageCombo" maxWidth="Infinity"
                                              promptText="Language" HBox.hgrow="ALWAYS"
                                              style="-fx-background-color: #0f172a;" />
                                    <ComboBox fx:id="typeCombo" maxWidth="Infinity"
                                              promptText="Type" HBox.hgrow="ALWAYS"
                                              style="-fx-background-color: #0f172a;" />
                                </children>
                            </HBox>

                            <TextField fx:id="titleField" promptText="Title *"
                                       style="-fx-background-color: #0f172a; -fx-text-fill: white;
                                              -fx-prompt-text-fill: #64748b; -fx-padding: 10;" />

                            <TextArea fx:id="instructionsArea" prefHeight="60.0"
                                      promptText="Instructions"
                                      style="-fx-control-inner-background: #0f172a;
                                             -fx-text-fill: white;" />

                            <TextArea fx:id="taskArea" prefHeight="50.0"
                                      promptText="Task"
                                      style="-fx-control-inner-background: #0f172a;
                                             -fx-text-fill: white;" />

                            <TextArea fx:id="starterCodeArea" prefHeight="100.0"
                                      promptText="Starter Code (use ___BLANK___ for blanks)"
                                      style="-fx-font-family: 'Consolas', monospace;
                                             -fx-control-inner-background: #0f172a;
                                             -fx-text-fill: #e2e8f0;" />

                            <TextArea fx:id="expectedOutputArea" prefHeight="50.0"
                                      promptText="Expected Output"
                                      style="-fx-font-family: 'Consolas', monospace;
                                             -fx-control-inner-background: #000000;
                                             -fx-text-fill: #4ade80;" />

                            <TextArea fx:id="hintArea" prefHeight="40.0"
                                      promptText="Hint"
                                      style="-fx-control-inner-background: #0f172a;
                                             -fx-text-fill: white;" />

                            <TextArea fx:id="solutionArea" prefHeight="100.0"
                                      promptText="Solution Code"
                                      style="-fx-font-family: 'Consolas', monospace;
                                             -fx-control-inner-background: #0f172a;
                                             -fx-text-fill: #e2e8f0;" />

                            <TextField fx:id="blanksField"
                                       promptText="Blanks (comma-separated)"
                                       style="-fx-background-color: #0f172a; -fx-text-fill: white;
                                              -fx-prompt-text-fill: #64748b; -fx-padding: 10;" />

                            <TextField fx:id="choicesField"
                                       promptText="Choices (comma-separated)"
                                       style="-fx-background-color: #0f172a; -fx-text-fill: white;
                                              -fx-prompt-text-fill: #64748b; -fx-padding: 10;" />

                            <Label fx:id="statusLabel"
                                   style="-fx-text-fill: #4ade80; -fx-font-weight: bold;" />

                            <!-- Buttons -->
                            <HBox spacing="10.0">
                                <children>
                                    <Button onAction="#handleSave" text="💾 Save"
                                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                            style="-fx-background-color: #10b981;
                                                   -fx-text-fill: white;
                                                   -fx-background-radius: 8px;
                                                   -fx-padding: 12;
                                                   -fx-font-weight: bold;
                                                   -fx-cursor: hand;" />
                                    <Button onAction="#handleClear" text="🗑 Clear"
                                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                            style="-fx-background-color: rgba(239,68,68,0.2);
                                                   -fx-text-fill: #f87171;
                                                   -fx-background-radius: 8px;
                                                   -fx-padding: 12;
                                                   -fx-cursor: hand;" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- RIGHT: TABLE -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12px;
                         -fx-border-color: rgba(56,189,248,0.2);
                         -fx-border-radius: 12px;
                         -fx-padding: 20;">
                <children>
                    <Label text="📋 All Practice Questions"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #38bdf8;" />

                    <TableView fx:id="questionTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #0f172a;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
                            <TableColumn fx:id="colLanguage" text="Language" prefWidth="90.0" />
                            <TableColumn fx:id="colTitle" text="Title" prefWidth="180.0" />
                            <TableColumn fx:id="colType" text="Type" prefWidth="100.0" />
                            <TableColumn fx:id="colTask" text="Task" prefWidth="250.0" />
                        </columns>
                    </TableView>

                    <HBox spacing="10.0">
                        <children>
                            <Button onAction="#handleLoadSelected" text="✏️ Load for Edit"
                                    style="-fx-background-color: rgba(56,189,248,0.2);
                                           -fx-text-fill: #38bdf8;
                                           -fx-background-radius: 6px;
                                           -fx-padding: 8 16; -fx-cursor: hand;" />
                            <Button onAction="#handleDeleteSelected" text="🗑 Delete Selected"
                                    style="-fx-background-color: rgba(239,68,68,0.2);
                                           -fx-text-fill: #f87171;
                                           -fx-background-radius: 6px;
                                           -fx-padding: 8 16; -fx-cursor: hand;" />
                        </children>
                    </HBox>
                </children>
            </VBox>

        </HBox>
    </center>

</BorderPane>