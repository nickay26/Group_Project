<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1150.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.AdminDashboardController">
    <stylesheets>
        <URL value="@../Css/admin.css" />
    </stylesheets>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220.0" spacing="20.0" styleClass="sidebar">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="logo-text" text="⚡ Quiz Admin" />
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" styleClass="sidebar-btn-active" text="Dashboard" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="sidebar-btn" text="Manage Questions" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="sidebar-btn" text="User Analytics" />
                        <Button maxWidth="1.7976931348623157E308" styleClass="sidebar-btn" text="Settings" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- CENTER MAIN CONTENT -->
    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <!-- TOP HEADER BAR -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="header-title" text="Welcome, Admin" />
                                <Label styleClass="header-sub" text="Manage your quiz questions and system data" />
                            </children>
                        </VBox>
                        <TextField promptText="🔍 Search questions..." styleClass="search-field" />
                    </children>
                </HBox>

                <!-- QUESTION FORM & TABLE SECTION -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- ADD / EDIT SLIDE FORM (LEFT PANEL) -->
                        <VBox prefWidth="420.0" spacing="10.0" styleClass="glass-panel">
                            <children>
                                <Label styleClass="section-title" text="Add / Edit Slide" />

                                <HBox spacing="10.0">
                                    <children>
                                        <ComboBox fx:id="categoryCombo" maxWidth="1.7976931348623157E308" promptText="Category" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="lessonCombo" maxWidth="1.7976931348623157E308" promptText="Lesson" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <ComboBox fx:id="typeCombo" maxWidth="1.7976931348623157E308" promptText="Select Slide Type" styleClass="input-field" />

                                <TextField fx:id="slideTitleInput" promptText="Slide Title (e.g., Basic Syntax)" styleClass="input-field" />
                                <TextArea fx:id="promptArea" prefHeight="65.0" promptText="Enter Prompt / Question Text" styleClass="input-field" wrapText="true" />
                                <TextArea fx:id="codeSnippetArea" prefHeight="65.0" promptText="Code Snippet (Optional)" styleClass="input-field" wrapText="true" />

                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="optA" promptText="Option A" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="optB" promptText="Option B" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <TextField fx:id="optC" promptText="Option C" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="optD" promptText="Option D" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <TextField fx:id="correctAnswerInput" promptText="Correct Answer Text" styleClass="input-field" />

                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" onAction="#handleSaveQuestion" styleClass="primary-btn" text="Save Slide" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="1.7976931348623157E308" onAction="#handleDeleteQuestion" styleClass="primary-btn" style="-fx-background-color: #dc2626;" text="Delete Selected" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- SLIDES LIST TABLE (RIGHT PANEL) -->
                        <VBox spacing="10.0" styleClass="glass-panel" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-title" text="Existing Slides List" />
                                <TableView fx:id="slideTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="100.0" text="Slide ID" />
                                        <TableColumn fx:id="colType" prefWidth="110.0" text="Type" />
                                        <TableColumn fx:id="colTitle" prefWidth="130.0" text="Title" />
                                        <TableColumn fx:id="colPrompt" prefWidth="200.0" text="Prompt" />
                                        <TableColumn fx:id="colAnswer" prefWidth="100.0" text="Answer" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>