<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Project.CodeEditorController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- TOP TOOLBAR -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleBackToDashboard"
                                style="-fx-background-color: rgba(255,255,255,0.1);
                                       -fx-text-fill: white; -fx-background-radius: 6px;
                                       -fx-cursor: hand; -fx-padding: 8 14;"
                                text="← Back" />
                        <Label fx:id="projectTitleLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;
                                      -fx-text-fill: #ffffff;"
                               text="Question Title" />
                        <Label fx:id="languageBadge"
                               style="-fx-background-color: #38bdf8;
                                      -fx-text-fill: #0f172a; -fx-background-radius: 12px;
                                      -fx-padding: 3 10; -fx-font-size: 11px;
                                      -fx-font-weight: bold;"
                               text="Java" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleHint"
                                style="-fx-background-color: rgba(251,191,36,0.2);
                                       -fx-text-fill: #fbbf24; -fx-background-radius: 6px;
                                       -fx-cursor: hand; -fx-padding: 8 14;"
                                text="💡 Hint" />
                        <Button onAction="#handleShowSolution"
                                style="-fx-background-color: rgba(139,92,246,0.2);
                                       -fx-text-fill: #a78bfa; -fx-background-radius: 6px;
                                       -fx-cursor: hand; -fx-padding: 8 14;"
                                text="👁 Solution" />
                        <Button onAction="#handleReviewCode" fx:id="reviewBtn"
                                style="-fx-background-color: #8b5cf6;
                                       -fx-text-fill: white; -fx-background-radius: 6px;
                                       -fx-cursor: hand; -fx-padding: 8 14;"
                                text="🤖 AI Review" />
                        <Button onAction="#handleCheckCode" fx:id="checkBtn"
                                style="-fx-background-color: #10b981;
                                       -fx-text-fill: white; -fx-background-radius: 6px;
                                       -fx-cursor: hand; -fx-padding: 8 14;"
                                text="✓ Check" />
                        <Button onAction="#handleRunCode" fx:id="runBtn"
                                style="-fx-background-color: #2563eb;
                                       -fx-text-fill: white; -fx-background-radius: 6px;
                                       -fx-cursor: hand; -fx-padding: 8 14;"
                                text="▶ Run" />
                    </children>
                </HBox>

                <!-- MAIN SPLIT -->
                <SplitPane dividerPositions="0.35"
                           style="-fx-background-color: transparent;"
                           VBox.vgrow="ALWAYS">
                    <items>

                        <!-- LEFT: INSTRUCTIONS -->
                        <VBox spacing="12.0"
                              style="-fx-background-color: rgba(30,41,59,0.7);
                                     -fx-background-radius: 10px; -fx-padding: 15;">
                            <children>
                                <ScrollPane fitToWidth="true"
                                            style="-fx-background-color: transparent;"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox spacing="15.0">
                                            <children>

                                                <!-- 📖 Instructions -->
                                                <Label style="-fx-font-size: 13px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #38bdf8;"
                                                       text="📖 INSTRUCTIONS" />
                                                <Label fx:id="instructionsLabel"
                                                       style="-fx-font-size: 12px;
                                                              -fx-text-fill: #cbd5e1;
                                                              -fx-line-spacing: 3px;"
                                                       text="Instructions here..."
                                                       wrapText="true" />

                                                <!-- 📝 Task -->
                                                <Label style="-fx-font-size: 13px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #38bdf8;
                                                              -fx-padding: 10 0 0 0;"
                                                       text="📝 YOUR TASK" />
                                                <Label fx:id="taskLabel"
                                                       style="-fx-font-size: 12px;
                                                              -fx-text-fill: #e2e8f0;
                                                              -fx-line-spacing: 3px;
                                                              -fx-background-color: rgba(56,189,248,0.08);
                                                              -fx-padding: 10;
                                                              -fx-background-radius: 6px;"
                                                       text="Task here..."
                                                       wrapText="true" />

                                                <!-- Expected Output -->
                                                <Label style="-fx-font-size: 13px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #38bdf8;
                                                              -fx-padding: 10 0 0 0;"
                                                       text="🎯 EXPECTED OUTPUT" />
                                                <Label fx:id="expectedOutputLabel"
                                                       style="-fx-font-family: 'Consolas', monospace;
                                                              -fx-font-size: 12px;
                                                              -fx-text-fill: #4ade80;
                                                              -fx-background-color: rgba(0,0,0,0.5);
                                                              -fx-padding: 10;
                                                              -fx-background-radius: 6px;"
                                                       text="Expected output..." />
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- RIGHT: EDITOR + OUTPUT -->
                        <VBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #94a3b8;"
                                       text="💻 CODE EDITOR" />
                                <TextArea fx:id="codeEditor"
                                          style="-fx-font-family: 'Consolas', monospace;
                                                 -fx-font-size: 13px;
                                                 -fx-control-inner-background: #0f172a;
                                                 -fx-text-fill: #e2e8f0;
                                                 -fx-border-color: rgba(56,189,248,0.3);
                                                 -fx-border-radius: 6px;"
                                          VBox.vgrow="ALWAYS" />

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #94a3b8;"
                                       text="▶ OUTPUT" />
                                <TextArea fx:id="outputConsole" editable="false"
                                          prefHeight="180.0"
                                          style="-fx-font-family: 'Consolas', monospace;
                                                 -fx-font-size: 12px;
                                                 -fx-control-inner-background: #000000;
                                                 -fx-text-fill: #4ade80;
                                                 -fx-border-color: rgba(56,189,248,0.3);
                                                 -fx-border-radius: 6px;" />

                                <Label style="-fx-font-size: 12px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #94a3b8;"
                                       text="🤖 AI FEEDBACK" />
                                <TextArea fx:id="aiReviewArea" editable="false"
                                          prefHeight="120.0"
                                          style="-fx-font-family: 'Consolas', monospace;
                                                 -fx-font-size: 12px;
                                                 -fx-control-inner-background: #1e1b4b;
                                                 -fx-text-fill: #c4b5fd;
                                                 -fx-border-color: rgba(139,92,246,0.3);
                                                 -fx-border-radius: 6px;" />
                            </children>
                        </VBox>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </children>
</AnchorPane>