<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.CodeEditorController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- TOP TOOLBAR -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleBackToDashboard" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-radius: 6px; -fx-cursor: hand;" text="← Back" />
                        <Label fx:id="projectTitleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #000000;" text="Project Title" />
                        <Label fx:id="languageBadge" style="-fx-background-color: #2FBDAE; -fx-background-radius: 12px; -fx-padding: 3 10; -fx-font-size: 11px; -fx-font-weight: bold;" text="C++" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button onAction="#handleSaveCode" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-radius: 6px; -fx-cursor: hand;" text="💾 Save" />
                        <Button onAction="#handleRunCode" style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF; -fx-background-radius: 6px; -fx-cursor: hand;" text="▶ Run Code" />
                    </children>
                </HBox>

                <!-- SPLIT EDITOR & OUTPUT -->
                <SplitPane dividerPositions="0.6" style="-fx-background-color: #FFFFFF; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
                    <items>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #666666;" text="CODE EDITOR" />
                                <TextArea fx:id="codeEditor" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px; -fx-border-color: #000000; -fx-border-radius: 6px;" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <children>
                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #666666;" text="TERMINAL OUTPUT" />
                                        <TextArea fx:id="outputConsole" editable="false" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px; -fx-border-color: #000000; -fx-border-radius: 6px;" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>

            </children>
        </VBox>
    </children>
</AnchorPane>