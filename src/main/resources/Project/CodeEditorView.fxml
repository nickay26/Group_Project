<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<AnchorPane styleClass="editor-root" stylesheets="@../Css/code_editor.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Project.CodeEditorController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>

                <!-- TOP TOOLBAR -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#handleBackToDashboard" styleClass="btn-secondary" text="← Back" />
                        <Label fx:id="projectTitleLabel" styleClass="title-text" text="Project Title" />
                        <Label fx:id="languageBadge" styleClass="lang-pill" text="C++" />

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Save, AI Review, and Run Buttons -->
                        <Button onAction="#handleSaveCode" styleClass="btn-secondary" text="💾 Save" />
                        <Button fx:id="reviewBtn" onAction="#handleReviewCode" styleClass="btn-ai" text="✨ Review with AI" />
                        <Button fx:id="runBtn" onAction="#handleRunCode" styleClass="btn-run" text="▶ Run Code" />
                    </children>
                </HBox>

                <!-- SPLIT EDITOR & OUTPUT PANELS -->
                <SplitPane dividerPositions="0.55" styleClass="split-pane" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- LEFT PANEL: MONACO CODE EDITOR -->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="section-header" text="CODE EDITOR" />
                                <WebView fx:id="codeWebView" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <!-- RIGHT PANEL: TERMINAL OUTPUT & AI REVIEW -->
                        <SplitPane dividerPositions="0.45" orientation="VERTICAL" styleClass="split-pane">
                            <items>
                                <!-- TERMINAL OUTPUT -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="section-header" text="TERMINAL OUTPUT" />
                                        <TextArea fx:id="outputConsole" editable="false" styleClass="dark-editor" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>

                                <!-- AI CODE REVIEW -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="section-header" text="✨ AI CODE REVIEW" />
                                        <TextArea fx:id="aiReviewArea" editable="false" promptText="Click 'Review with AI' to analyze code quality and optimizations..." styleClass="dark-editor" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </items>
                        </SplitPane>
                    </items>
                </SplitPane>

            </children>
        </VBox>
    </children>
</AnchorPane>